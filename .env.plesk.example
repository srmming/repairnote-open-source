# Plesk 上的 MySQL / MariaDB 连接串
# 在 Plesk「数据库」里新建数据库与用户后，按下面格式填写（主机一般是 localhost，端口 3306）
DATABASE_URL="mysql://数据库用户名:数据库密码@localhost:3306/数据库名"

# 首次安装（空库）时创建的首位管理员，同时是系统主管理员和默认门户管理员。必须是真实密码（至少 8 位，不能是 admin123 等默认值）。
REPAIRNOTE_ADMIN_USERNAME="admin"
REPAIRNOTE_ADMIN_PASSWORD=""

# 浏览器访问本系统的唯一 https 地址（不带路径），例如 https://repair.example.com
REPAIRNOTE_PUBLIC_ORIGIN=""

# 旧单门户数据库升级时必填：原管理员的 Staff ID，升级后成为系统主管理员；新装空库留空。
# REPAIRNOTE_SYSTEM_ADMIN_STAFF_ID=""

REPAIRNOTE_COOKIE_SECURE=true
