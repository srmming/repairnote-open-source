# MySQL / MariaDB 连接串（本地 docker-compose 默认映射到 3308；Plesk 通常是 3306）
# 格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://repairnote:repairnote@127.0.0.1:3308/repairnote"

# 首次安装（空库）时创建的首位管理员，同时是系统主管理员和默认门户管理员。
# 必须填写真实密码：留空、admin123、123456、change-this-before-deploy 等默认值都会让初始化失败，不会创建账号。
REPAIRNOTE_ADMIN_USERNAME="admin"
REPAIRNOTE_ADMIN_PASSWORD=""

# 浏览器访问本系统的唯一地址（不带路径）。系统管理写接口（设置 → 门户管理）只接受来自这个 origin 的请求。
REPAIRNOTE_PUBLIC_ORIGIN="http://localhost:3000"

# 旧单门户数据库升级到多门户时必填：原管理员的 Staff ID（在旧系统数据库 Staff 表里查），升级后成为系统主管理员。
# 新装空库不需要。
# REPAIRNOTE_SYSTEM_ADMIN_STAFF_ID=""

REPAIRNOTE_COOKIE_SECURE=false
# 本地开发想要演示数据时打开（生产无效）
# REPAIRNOTE_SEED_DEMO=true
