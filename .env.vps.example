MYSQL_USER=repairnote
MYSQL_PASSWORD=repairnote-mysql-123
MYSQL_DATABASE=repairnote
REPAIRNOTE_PORT=3000
REPAIRNOTE_COOKIE_SECURE=false
# 首次安装的首位管理员（系统主管理员 + 默认门户管理员）。必须填写真实密码，默认 / 弱密码会让初始化失败。
REPAIRNOTE_ADMIN_USERNAME=admin
REPAIRNOTE_ADMIN_PASSWORD=
# 浏览器访问本系统的唯一地址（不带路径），例如 https://repair.example.com；未启用 https 时可为 http://主机:3000
REPAIRNOTE_PUBLIC_ORIGIN=
# 旧单门户库升级时必填：原管理员的 Staff ID；新装留空
REPAIRNOTE_SYSTEM_ADMIN_STAFF_ID=
